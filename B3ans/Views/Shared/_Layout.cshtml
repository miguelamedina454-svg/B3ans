
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - b3ans</title>

    <meta name="description"
          content="b3ans - Clothing, stickers, and other questionable decisions." />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fredoka:wght@400;500;600;700&display=swap"
          rel="stylesheet" />

    <!-- Site Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <header class="site-header">
        <div class="header-container">

            <a asp-controller="Home"
               asp-action="Index"
               class="brand-logo">
                b3ans<span>.</span>
            </a>

            <nav class="main-navigation">
                <a asp-controller="Home"
                   asp-action="Index">Home</a>

                <a asp-controller="Shop"
                   asp-action="Index">Shop</a>

                <a asp-controller="About"
                   asp-action="Index">About</a>
            </nav>

            <div class="header-actions">
                <a href="#" class="cart-link">
                    <span>Cart</span>
                    <span class="cart-count">0</span>
                </a>
            </div>

        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="footer-container">

            <div class="footer-brand">
                <h2>b3ans.</h2>
                <p>Good beans. Questionable decisions.</p>
            </div>

            <div class="footer-links">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a asp-controller="Shop" asp-action="Index">Shop</a>
                <a asp-controller="About" asp-action="Index">About</a>
                <a href="mailto:hello@b3ans.com">Contact</a>
            </div>

            <div class="footer-bottom">
                <p>&copy; @DateTime.Now.Year b3ans. All rights reserved.</p>
            </div>

        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
